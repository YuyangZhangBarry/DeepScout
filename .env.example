# DeepSeek (OpenAI-compatible API) — required for POST /v1/research/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Literature search: semantic_scholar (default, papers) or tavily (general web)
SEARCH_PROVIDER=semantic_scholar
# Recommended: higher rate limits than anonymous usage (see https://www.semanticscholar.org/product/api )
SEMANTIC_SCHOLAR_API_KEY=
# Burst parallel S2 requests often 429 without a key; default is sequential + delay.
SEMANTIC_SCHOLAR_PARALLEL=false
SEMANTIC_SCHOLAR_INTER_QUERY_DELAY_SECONDS=0.55
SEARCH_MAX_RESULTS_PER_QUERY=5

# Tavily (only when SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=

# HTTP fetch (polite defaults)
HTTP_USER_AGENT="DeepScout/0.1 (research bot)"
FETCH_TIMEOUT_SECONDS=25
FETCH_MAX_CONCURRENT=5
# Agent orchestration (search empty → one LLM rewrite; fetch failures → second round)
RESEARCH_SEARCH_RETRY_ON_EMPTY=true
RESEARCH_FETCH_MAX_ROUNDS=2

# RAG (OpenAI-compatible embeddings API + local Chroma persist dir)
RAG_ENABLED=true
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_API_KEY=
# If EMBEDDING_API_KEY is empty, OPENAI_API_KEY is used when set
OPENAI_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=12
RAG_HYBRID_ENABLED=true
RAG_HYBRID_POOL=32
RAG_HYBRID_RRF_K=60

# App
APP_NAME=DeepScout
DEBUG=false
