# DeepSeek (OpenAI-compatible API) — required for POST /v1/research/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Literature search: comma-separated academic providers (default: Semantic Scholar + arXiv),
# or tavily (general web, cannot be combined with academic providers).
SEARCH_PROVIDER=semantic_scholar,arxiv
# Recommended: higher rate limits than anonymous usage (see https://www.semanticscholar.org/product/api )
SEMANTIC_SCHOLAR_API_KEY=
# Burst parallel S2 requests often 429 without a key; default is sequential + delay.
SEMANTIC_SCHOLAR_PARALLEL=false
# Extra pause between sub-queries (seconds); main spacing is MIN_SECONDS_BETWEEN_REQUESTS.
SEMANTIC_SCHOLAR_INTER_QUERY_DELAY_SECONDS=0
# Key tier introductory limit is ~1 req/s; enforced globally per server process for paper/search.
SEMANTIC_SCHOLAR_MIN_SECONDS_BETWEEN_REQUESTS=1.0
SEARCH_MAX_RESULTS_PER_QUERY=5
# arXiv official API asks clients to be polite; keep requests spaced out.
ARXIV_MIN_SECONDS_BETWEEN_REQUESTS=3.0

# Tavily (only when SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=

# HTTP fetch (polite defaults)
HTTP_USER_AGENT="DeepScout/0.1 (research bot)"
FETCH_TIMEOUT_SECONDS=25
FETCH_MAX_CONCURRENT=5
FETCH_PER_HOST_MAX_CONCURRENT=2
FETCH_PER_HOST_DELAY_SECONDS=0.25
# Agent orchestration (search empty → one LLM rewrite; fetch failures → second round)
RESEARCH_SEARCH_RETRY_ON_EMPTY=true
RESEARCH_FETCH_MAX_ROUNDS=2

# RAG (OpenAI-compatible embeddings API + local Chroma persist dir)
RAG_ENABLED=true
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_API_KEY=
# If EMBEDDING_API_KEY is empty, OPENAI_API_KEY is used when set
OPENAI_API_KEY=
# Root (https://api.openai.com) or .../v1 — both are valid
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
# Pace batches (~100 RPM on many OpenAI embedding tiers); 429/503 → retries with backoff
EMBEDDING_MIN_SECONDS_BETWEEN_BATCHES=0.65
EMBEDDING_MAX_RETRIES=8
EMBEDDING_RETRY_BASE_SECONDS=1.0
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=12
RAG_HYBRID_ENABLED=true
RAG_HYBRID_POOL=32
RAG_HYBRID_RRF_K=60

# App
APP_NAME=DeepScout
DEBUG=false
# Backend step/research logs: leave empty for stderr only, or set a path (UTF-8 append), e.g.:
# LOG_FILE=./data/logs/deepscout.log
LOG_FILE=

# PDF (job download): tries WeasyPrint first (install system libs per
# https://doc.courtbouillon.org/weasyprint/stable/first_steps.html#installation ,
# e.g. macOS: brew install pango). Otherwise fpdf2 + a system Unicode TTF
# (e.g. Arial Unicode on macOS, DejaVu on many Linux distros), then a minimal Latin fallback.
